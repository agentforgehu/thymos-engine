{"id": "cped-window-27_000", "source": {"dataset": "CPED", "split": "test", "repository": "https://github.com/scutcyr/CPED", "paper": "https://arxiv.org/abs/2205.14727", "license": "Apache-2.0 (repository); see NOTICE.md", "dialogue_id": "27_000", "speaker": "林宛瑜"}, "scenario": "下班后想找个人说说今天发生的事", "probe": "今晚整体怎么样？", "events": [{"text": "好了没事了", "at": 1770000000.0, "role": "user", "tags": ["car"], "metadata": {"source_utterance_id": "27_000_000", "source_emotion": "neutral"}}, {"text": "谢谢你哦", "at": 1770000900.0, "role": "user", "tags": ["car"], "metadata": {"source_utterance_id": "27_000_001", "source_emotion": "neutral"}}, {"text": "喂", "at": 1770001800.0, "role": "user", "tags": ["car"], "metadata": {"source_utterance_id": "27_000_003", "source_emotion": "astonished"}}, {"text": "没事吧", "at": 1770002700.0, "role": "user", "tags": ["car"], "metadata": {"source_utterance_id": "27_000_004", "source_emotion": "astonished"}}, {"text": "借你这儿躲一下", "at": 1770003600.0, "role": "user", "tags": ["car"], "metadata": {"source_utterance_id": "27_000_005", "source_emotion": "disgust"}}, {"text": "不至于吧", "at": 1770004500.0, "role": "user", "tags": ["car"], "metadata": {"source_utterance_id": "27_000_006", "source_emotion": "disgust"}}], "expected": {"label_source": "CPED sentiment/emotion annotations (derived window majority)", "turns": 6, "sentiment_counts": {"neutral": 2, "negative": 4}, "emotion_counts": {"neutral": 2, "astonished": 2, "disgust": 2}, "majority_sentiment": "negative"}}
{"id": "cped-window-27_262", "source": {"dataset": "CPED", "split": "test", "repository": "https://github.com/scutcyr/CPED", "paper": "https://arxiv.org/abs/2205.14727", "license": "Apache-2.0 (repository); see NOTICE.md", "dialogue_id": "27_262", "speaker": "吕子乔"}, "scenario": "下班后想找个人说说今天发生的事", "probe": "今晚整体怎么样？", "events": [{"text": "曾老师完全不用担心这个问题", "at": 1770000000.0, "role": "user", "tags": ["home"], "metadata": {"source_utterance_id": "27_262_002", "source_emotion": "relaxed"}}, {"text": "我自己想办法", "at": 1770000900.0, "role": "user", "tags": ["home"], "metadata": {"source_utterance_id": "27_262_003", "source_emotion": "relaxed"}}, {"text": "哄他", "at": 1770001800.0, "role": "user", "tags": ["home"], "metadata": {"source_utterance_id": "27_262_005", "source_emotion": "astonished"}}, {"text": "为什么", "at": 1770002700.0, "role": "user", "tags": ["home"], "metadata": {"source_utterance_id": "27_262_006", "source_emotion": "astonished"}}, {"text": "我堂堂7尺男儿干嘛非得哄他", "at": 1770003600.0, "role": "user", "tags": ["home"], "metadata": {"source_utterance_id": "27_262_007", "source_emotion": "anger"}}, {"text": "昨天晚上我已经考虑过", "at": 1770004500.0, "role": "user", "tags": ["home"], "metadata": {"source_utterance_id": "27_262_008", "source_emotion": "neutral"}}], "expected": {"label_source": "CPED sentiment/emotion annotations (derived window majority)", "turns": 6, "sentiment_counts": {"positive": 2, "negative": 3, "neutral": 1}, "emotion_counts": {"relaxed": 2, "astonished": 2, "anger": 1, "neutral": 1}, "majority_sentiment": "negative"}}
{"id": "cped-window-28_012", "source": {"dataset": "CPED", "split": "test", "repository": "https://github.com/scutcyr/CPED", "paper": "https://arxiv.org/abs/2205.14727", "license": "Apache-2.0 (repository); see NOTICE.md", "dialogue_id": "28_012", "speaker": "张伟"}, "scenario": "下班后想找个人说说今天发生的事", "probe": "今晚整体怎么样？", "events": [{"text": "一菲 我记得你在招新的室友", "at": 1770000000.0, "role": "user", "tags": ["home"], "metadata": {"source_utterance_id": "28_012_001", "source_emotion": "anger"}}, {"text": "可是你们3个人住4个人的房间负担太重", "at": 1770000900.0, "role": "user", "tags": ["home"], "metadata": {"source_utterance_id": "28_012_003", "source_emotion": "neutral"}}, {"text": "要不过来给你们分担一下", "at": 1770001800.0, "role": "user", "tags": ["home"], "metadata": {"source_utterance_id": "28_012_004", "source_emotion": "neutral"}}, {"text": "不瞒你说", "at": 1770002700.0, "role": "user", "tags": ["home"], "metadata": {"source_utterance_id": "28_012_006", "source_emotion": "neutral"}}, {"text": "其实我很反感隔壁他们的生活习惯", "at": 1770003600.0, "role": "user", "tags": ["home"], "metadata": {"source_utterance_id": "28_012_007", "source_emotion": "neutral"}}, {"text": "用一个字来形容", "at": 1770004500.0, "role": "user", "tags": ["home"], "metadata": {"source_utterance_id": "28_012_008", "source_emotion": "neutral"}}], "expected": {"label_source": "CPED sentiment/emotion annotations (derived window majority)", "turns": 6, "sentiment_counts": {"negative": 1, "neutral": 5}, "emotion_counts": {"anger": 1, "neutral": 5}, "majority_sentiment": "neutral"}}
{"id": "cped-window-29_018", "source": {"dataset": "CPED", "split": "test", "repository": "https://github.com/scutcyr/CPED", "paper": "https://arxiv.org/abs/2205.14727", "license": "Apache-2.0 (repository); see NOTICE.md", "dialogue_id": "29_018", "speaker": "胡一菲"}, "scenario": "下班后想找个人说说今天发生的事", "probe": "今晚整体怎么样？", "events": [{"text": "我原以为博士论文是挑战", "at": 1770000000.0, "role": "user", "tags": ["restaurant"], "metadata": {"source_utterance_id": "29_018_003", "source_emotion": "negative-other"}}, {"text": "谁知道那么轻松", "at": 1770000900.0, "role": "user", "tags": ["restaurant"], "metadata": {"source_utterance_id": "29_018_004", "source_emotion": "negative-other"}}, {"text": "这个世界上还是有钱买不来的东西", "at": 1770001800.0, "role": "user", "tags": ["restaurant"], "metadata": {"source_utterance_id": "29_018_005", "source_emotion": "neutral"}}, {"text": "钱可以买到榨汁机", "at": 1770002700.0, "role": "user", "tags": ["restaurant"], "metadata": {"source_utterance_id": "29_018_006", "source_emotion": "neutral"}}, {"text": "买不来我要的挑战 你省省吧", "at": 1770003600.0, "role": "user", "tags": ["restaurant"], "metadata": {"source_utterance_id": "29_018_007", "source_emotion": "disgust"}}], "expected": {"label_source": "CPED sentiment/emotion annotations (derived window majority)", "turns": 5, "sentiment_counts": {"negative": 3, "neutral": 2}, "emotion_counts": {"negative-other": 2, "neutral": 2, "disgust": 1}, "majority_sentiment": "negative"}}
{"id": "cped-window-29_358", "source": {"dataset": "CPED", "split": "test", "repository": "https://github.com/scutcyr/CPED", "paper": "https://arxiv.org/abs/2205.14727", "license": "Apache-2.0 (repository); see NOTICE.md", "dialogue_id": "29_358", "speaker": "吕子乔"}, "scenario": "下班后想找个人说说今天发生的事", "probe": "今晚整体怎么样？", "events": [{"text": "当一个男人找到一个目标", "at": 1770000000.0, "role": "user", "tags": ["outdoor"], "metadata": {"source_utterance_id": "29_358_001", "source_emotion": "neutral"}}, {"text": "别说是帐篷", "at": 1770000900.0, "role": "user", "tags": ["outdoor"], "metadata": {"source_utterance_id": "29_358_002", "source_emotion": "neutral"}}, {"text": "别墅都搭好了", "at": 1770001800.0, "role": "user", "tags": ["outdoor"], "metadata": {"source_utterance_id": "29_358_003", "source_emotion": "neutral"}}, {"text": "展博", "at": 1770002700.0, "role": "user", "tags": ["outdoor"], "metadata": {"source_utterance_id": "29_358_005", "source_emotion": "depress"}}, {"text": "作为一个男人", "at": 1770003600.0, "role": "user", "tags": ["outdoor"], "metadata": {"source_utterance_id": "29_358_006", "source_emotion": "neutral"}}, {"text": "你应该关心的不是帐篷", "at": 1770004500.0, "role": "user", "tags": ["outdoor"], "metadata": {"source_utterance_id": "29_358_007", "source_emotion": "neutral"}}], "expected": {"label_source": "CPED sentiment/emotion annotations (derived window majority)", "turns": 6, "sentiment_counts": {"neutral": 5, "negative": 1}, "emotion_counts": {"neutral": 5, "depress": 1}, "majority_sentiment": "neutral"}}
{"id": "cped-window-30_231", "source": {"dataset": "CPED", "split": "test", "repository": "https://github.com/scutcyr/CPED", "paper": "https://arxiv.org/abs/2205.14727", "license": "Apache-2.0 (repository); see NOTICE.md", "dialogue_id": "30_231", "speaker": "唐悠悠"}, "scenario": "下班后想找个人说说今天发生的事", "probe": "今晚整体怎么样？", "events": [{"text": "做老师至少不会影响健康尊严", "at": 1770000000.0, "role": "user", "tags": ["home"], "metadata": {"source_utterance_id": "30_231_001", "source_emotion": "neutral"}}, {"text": "还有智商", "at": 1770000900.0, "role": "user", "tags": ["home"], "metadata": {"source_utterance_id": "30_231_002", "source_emotion": "neutral"}}, {"text": "而且很有意义", "at": 1770001800.0, "role": "user", "tags": ["home"], "metadata": {"source_utterance_id": "30_231_003", "source_emotion": "neutral"}}, {"text": "可你教的那些孩子没准比你幸运", "at": 1770002700.0, "role": "user", "tags": ["home"], "metadata": {"source_utterance_id": "30_231_007", "source_emotion": "worried"}}, {"text": "他们会遇到一个更加负责更有责任心的老师", "at": 1770003600.0, "role": "user", "tags": ["home"], "metadata": {"source_utterance_id": "30_231_008", "source_emotion": "worried"}}, {"text": "而这个关谷老师一定不会让这种尴尬再发生了", "at": 1770004500.0, "role": "user", "tags": ["home"], "metadata": {"source_utterance_id": "30_231_009", "source_emotion": "worried"}}], "expected": {"label_source": "CPED sentiment/emotion annotations (derived window majority)", "turns": 6, "sentiment_counts": {"neutral": 3, "negative": 3}, "emotion_counts": {"neutral": 3, "worried": 3}, "majority_sentiment": "neutral"}}
{"id": "cped-window-34_239", "source": {"dataset": "CPED", "split": "test", "repository": "https://github.com/scutcyr/CPED", "paper": "https://arxiv.org/abs/2205.14727", "license": "Apache-2.0 (repository); see NOTICE.md", "dialogue_id": "34_239", "speaker": "邓小可"}, "scenario": "下班后想找个人说说今天发生的事", "probe": "今晚整体怎么样？", "events": [{"text": "哟 妈", "at": 1770000000.0, "role": "user", "tags": ["home"], "metadata": {"source_utterance_id": "34_239_000", "source_emotion": "neutral"}}, {"text": "怎么不做饭呀", "at": 1770000900.0, "role": "user", "tags": ["home"], "metadata": {"source_utterance_id": "34_239_001", "source_emotion": "neutral"}}, {"text": "您想把我饿死呀", "at": 1770001800.0, "role": "user", "tags": ["home"], "metadata": {"source_utterance_id": "34_239_002", "source_emotion": "neutral"}}, {"text": "干嘛呢", "at": 1770002700.0, "role": "user", "tags": ["home"], "metadata": {"source_utterance_id": "34_239_003", "source_emotion": "neutral"}}, {"text": "怎么了妈", "at": 1770003600.0, "role": "user", "tags": ["home"], "metadata": {"source_utterance_id": "34_239_004", "source_emotion": "worried"}}, {"text": "出什么事了", "at": 1770004500.0, "role": "user", "tags": ["home"], "metadata": {"source_utterance_id": "34_239_006", "source_emotion": "worried"}}], "expected": {"label_source": "CPED sentiment/emotion annotations (derived window majority)", "turns": 6, "sentiment_counts": {"neutral": 4, "negative": 2}, "emotion_counts": {"neutral": 4, "worried": 2}, "majority_sentiment": "neutral"}}
{"id": "cped-window-36_065", "source": {"dataset": "CPED", "split": "test", "repository": "https://github.com/scutcyr/CPED", "paper": "https://arxiv.org/abs/2205.14727", "license": "Apache-2.0 (repository); see NOTICE.md", "dialogue_id": "36_065", "speaker": "刘星"}, "scenario": "下班后想找个人说说今天发生的事", "probe": "今晚整体怎么样？", "events": [{"text": "这是柯达雷斯 柯跟啊 一个木字旁", "at": 1770000000.0, "role": "user", "tags": ["home"], "metadata": {"source_utterance_id": "36_065_001", "source_emotion": "depress"}}, {"text": "一个耳刀旁", "at": 1770000900.0, "role": "user", "tags": ["home"], "metadata": {"source_utterance_id": "36_065_002", "source_emotion": "depress"}}, {"text": "一不留神就上当了", "at": 1770001800.0, "role": "user", "tags": ["home"], "metadata": {"source_utterance_id": "36_065_003", "source_emotion": "depress"}}, {"text": "这是冒牌货", "at": 1770002700.0, "role": "user", "tags": ["home"], "metadata": {"source_utterance_id": "36_065_004", "source_emotion": "anger"}}, {"text": "我也跟你去", "at": 1770003600.0, "role": "user", "tags": ["home"], "metadata": {"source_utterance_id": "36_065_007", "source_emotion": "neutral"}}, {"text": "要是真吵起来", "at": 1770004500.0, "role": "user", "tags": ["home"], "metadata": {"source_utterance_id": "36_065_009", "source_emotion": "neutral"}}], "expected": {"label_source": "CPED sentiment/emotion annotations (derived window majority)", "turns": 6, "sentiment_counts": {"negative": 4, "neutral": 2}, "emotion_counts": {"depress": 3, "anger": 1, "neutral": 2}, "majority_sentiment": "negative"}}
